# changes/routing-keyboard-select T3 — FR-4 fallback members on a real pty.
# Each mode falsifies exactly one capable-terminal member; the comma form must
# render (`(comma-separated numbers)` + a `> ` line, no keyboard list).
#   dumb       TERM=dumb; `1,5` is accepted, then Ctrl-C at the roster
#              question (the comma path's Ctrl-C: exit 130, as on the
#              keyboard path — Pivot B)
#   norawmode  node -r <preload> deletes tty.ReadStream#setRawMode
#   piped      the CLI's stdout is piped through `cat`
# argv: node bin project home log mode [preload]
#   (transcript -> <log>; stdout stays quiet)
set timeout 20
set node [lindex $argv 0]
set bin [lindex $argv 1]
set proj [lindex $argv 2]
set home [lindex $argv 3]
set mode [lindex $argv 5]
set preload [lindex $argv 6]
log_user 0
log_file -a -noappend [lindex $argv 4]
set env(HOME) $home
set env(USERPROFILE) $home
set env(PS1) "SH> "
if {$mode eq "dumb"} {
  set env(TERM) "dumb"
} elseif {![info exists env(TERM)] || $env(TERM) eq "" || $env(TERM) eq "dumb"} {
  set env(TERM) "xterm-256color"
}
proc fail {what} { send_log "\n<<TIMEOUT: $what>>\n"; exit 2 }
# T6 (V-2): Ctrl-C, then a two-stage wait for the shell prompt, so a slow or
# missed return is legible in the transcript instead of a bare wait timeout.
# Each wait carries its own `timeout` branch, so `expect_after` cannot
# pre-empt it; `timeout` is proc-local (a braced list after `-timeout n`
# would be read as ONE pattern). Logs <<BACK-IN n ms>> on return.
proc ctrl_c_to_shell {} {
  set t0 [clock milliseconds]
  send "\003"
  set timeout 25
  expect {
    "SH> " {}
    timeout {
      send_log "\n<<NO-PROMPT-AFTER-CTRL-C>>\n"
      send "\003"
      set timeout 10
      expect {
        "SH> " {}
        timeout { send_log "\n<<HUNG>>\n"; exit 99 }
      }
    }
  }
  send_log "\n<<BACK-IN [expr {[clock milliseconds] - $t0}] ms>>\n"
}

switch -- $mode {
  dumb      { set cmd "'$node' '$bin' routing --project '$proj'" }
  norawmode { set cmd "'$node' -r '$preload' '$bin' routing --project '$proj'" }
  piped     { set cmd "'$node' '$bin' routing --project '$proj' | cat" }
  default   { send_log "\n<<BAD MODE: $mode>>\n"; exit 3 }
}

spawn /bin/sh
# expect_after binds to the current spawn id, so it must follow `spawn`; the
# pattern list spans lines (a one-line braced list is read as ONE pattern).
expect_after {
  timeout { fail "unmatched wait" }
  eof { fail "early eof" }
}
expect "SH> "
send "$cmd\r"

expect -re {Which hosts do you use\?[^\n]*\n(?:[^\n]*\n)*?> }
if {$mode eq "dumb"} {
  send "1,5\r"
  expect -re {Claude Code — which models do you have\?[^\n]*\n(?:[^\n]*\n)*?> }
}
ctrl_c_to_shell

# The tty probe (bugfix/pty-harness-ubuntu-flake DD-2): one `\n`-terminated
# line — still run by the shell if icrnl was left off — that saves `$?` first,
# prints the four flags, the shell's process group and the terminal's
# foreground group as `TTY=…` (typed as `T""TY=`, so the echo of the typed
# line cannot satisfy the wait), then `RC=<saved $?>`.
send "__rc=\$?; echo T\"\"TY=\$(stty -a | tr ';' '\\n' | grep -o -w -- '-\\?\\(icrnl\\|icanon\\|isig\\|echo\\)' | tr '\\n' ' ') PG=\$(ps -o pgid= -p \$\$ | tr -d ' ') FG=\$(ps -o tpgid= -p \$\$ | tr -d ' '); echo RC=\$__rc\n"
expect -re {TTY=([^\r\n]*)\r?\n}
send_log "\n<<TTY: $expect_out(1,string)>>\n"
expect -re {RC=\d+}
send "exit\n"
expect eof
