# changes/routing-keyboard-select T3 — FR-2 *Keyboard path* on a real pty:
# Enter with nothing marked shows the guidance line and the question stays
# open; space + Enter then proceeds to the next question.
# argv: node bin project home log  (transcript -> <log>; stdout stays quiet)
set timeout 20
set node [lindex $argv 0]
set bin [lindex $argv 1]
set proj [lindex $argv 2]
set home [lindex $argv 3]
log_user 0
log_file -a -noappend [lindex $argv 4]
set env(HOME) $home
set env(USERPROFILE) $home
set env(PS1) "SH> "
if {![info exists env(TERM)] || $env(TERM) eq "" || $env(TERM) eq "dumb"} { set env(TERM) "xterm-256color" }
proc fail {what} { send_log "\n<<TIMEOUT: $what>>\n"; exit 2 }
# T6 (V-2): Ctrl-C, then a two-stage wait for the shell prompt, so a slow or
# missed return is legible in the transcript instead of a bare wait timeout.
# Each wait carries its own `timeout` branch, so `expect_after` cannot
# pre-empt it; `timeout` is proc-local (a braced list after `-timeout n`
# would be read as ONE pattern). Logs <<BACK-IN n ms>> on return.
proc ctrl_c_to_shell {} {
  set t0 [clock milliseconds]
  send "\003"
  set timeout 25
  expect {
    "SH> " {}
    timeout {
      send_log "\n<<NO-PROMPT-AFTER-CTRL-C>>\n"
      send "\003"
      set timeout 10
      expect {
        "SH> " {}
        timeout { send_log "\n<<HUNG>>\n"; exit 99 }
      }
    }
  }
  send_log "\n<<BACK-IN [expr {[clock milliseconds] - $t0}] ms>>\n"
}

spawn /bin/sh
# expect_after binds to the current spawn id, so it must follow `spawn`; the
# pattern list spans lines (a one-line braced list is read as ONE pattern).
expect_after {
  timeout { fail "unmatched wait" }
  eof { fail "early eof" }
}
expect "SH> "
send "'$node' '$bin' routing --project '$proj'\r"

expect -re {Which hosts do you use\?}
expect -re {Enter confirms}
send "\r"
expect -re {mark at least one option — space toggles, Enter confirms}
send " "
send "\r"
expect -re {Claude Code — which models do you have\?}
expect -re {Enter confirms}
ctrl_c_to_shell

send "echo RC=\$?\r"
expect -re {RC=\d+}
send "stty -a | tr ';' '\\n' | grep -w -o -- '-\\?echo' | head -1\r"
expect -re {\r\n(-?echo)\r\n}
send_log "\n<<STTY: $expect_out(1,string)>>\n"
send "exit\r"
expect eof
