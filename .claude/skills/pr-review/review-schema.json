{
  "type": "object",
  "properties": {
    "schema_version": { "type": "string", "enum": ["1"] },
    "target": {
      "type": "object",
      "properties": {
        "kind": { "type": "string", "enum": ["pr", "range", "staged"] },
        "pr": { "type": ["integer", "null"] },
        "repo": { "type": ["string", "null"] },
        "base_sha": { "type": "string" },
        "head_sha": { "type": "string" }
      },
      "required": ["kind", "pr", "repo", "base_sha", "head_sha"],
      "additionalProperties": false
    },
    "tier": { "type": "string", "enum": ["trivial", "lite", "full"] },
    "host_mode": { "type": "string", "enum": ["parallel", "sequential"] },
    "lenses": { "type": "array", "items": { "type": "string" } },
    "top_risks": { "type": "array", "items": { "type": "string" } },
    "coverage": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "spec": { "type": "string" },
          "fr": { "type": "string" },
          "status": { "type": "string", "enum": ["met", "missing", "partial", "not-claimed"] },
          "evidence": { "type": "string" }
        },
        "required": ["spec", "fr", "status", "evidence"],
        "additionalProperties": false
      }
    },
    "unspecified_changes": { "type": "array", "items": { "type": "string" } },
    "notes": { "type": "array", "items": { "type": "string" } },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "lens": {
            "type": "string",
            "enum": ["spec", "correctness", "tests", "maintainability", "security", "docs"]
          },
          "severity": { "type": "string", "enum": ["critical", "warning", "suggestion"] },
          "suspect": { "type": "boolean" },
          "confidence": { "type": "integer" },
          "file": { "type": "string" },
          "line_start": { "type": "integer" },
          "line_end": { "type": "integer" },
          "side": { "type": "string", "enum": ["RIGHT", "LEFT"] },
          "evidence": { "type": "string" },
          "why": { "type": "string" },
          "fix": { "type": ["string", "null"] }
        },
        "required": [
          "id", "lens", "severity", "suspect", "confidence", "file", "line_start",
          "line_end", "side", "evidence", "why", "fix"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version", "target", "tier", "host_mode", "lenses", "top_risks", "coverage",
    "unspecified_changes", "notes", "findings"
  ],
  "additionalProperties": false
}
