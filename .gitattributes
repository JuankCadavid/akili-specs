# T13 (changes/model-routing-configurator), NFR-4 Cross-platform.
#
# Windows CI (core.autocrlf=true) converts LF-committed fixtures to CRLF on
# checkout. test/routing.test.js and test/persona-digests.test.js /
# test/agents-doctor*.test.js assert byte-exact fixture content, including
# the deliberate CRLF fixtures (agents-crlf.md, personas/crlf.md) that must
# stay CRLF on every platform. Declaring the whole fixture tree byte-exact
# keeps every fixture's committed line ending intact regardless of checkout
# platform or autocrlf setting.
test/fixtures/** -text

# changes/flow-diagram-animated T1, NFR-3 Cross-platform.
#
# Windows CI (core.autocrlf=true) would check both SVGs out with CRLF.
# test/flow-figure-animated.test.js asserts the committed animated asset is
# byte-identical to animate(static), and animate() writes LF; a CRLF checkout
# of either file makes that comparison fail on the windows-latest legs.
# Declaring both figures byte-exact keeps their committed LF on every platform.
assets/akili-flow.svg -text
assets/akili-flow-animated.svg -text

# changes/impeccable-hardening T1, DD-6 / NFR-3 Cross-platform.
#
# The vendored Impeccable tree is hash-locked in UPSTREAM.md and
# `impeccable.cmd` must stay CRLF (cmd.exe parses by byte offset). Declaring
# the tree byte-exact keeps every committed byte intact on Windows CI.
.claude/skills/impeccable/** -text

# changes/go-backend-routing/golang-skill T2, FR-2 / DD-2 / P-9 Cross-platform.
#
# The vendored golang-pro tree is hash-locked by test/golang-skill.test.js
# (git blob SHAs of the pinned upstream bytes). A Windows checkout that
# rewrote LF to CRLF would change every hash, so the tree is declared
# byte-exact and every committed byte stays intact on Windows CI.
.claude/skills/golang-pro/** -text

# changes/java-springboot-skill T2, FR-2 / NFR-3 Cross-platform.
#
# The vendored java-springboot tree is hash-locked by
# test/java-springboot-skill.test.js (git blob SHAs of the pinned upstream
# bytes). A Windows checkout that rewrote LF to CRLF would change every hash,
# so the tree is declared byte-exact.
.claude/skills/java-springboot/** -text

# changes/nestjs-official-skills T2, FR-1 / NFR-3 Cross-platform.
#
# The six vendored official NestJS skills are hash-locked by UPSTREAM.md and
# test/nestjs-vendor.test.js (sha256 over raw bytes). A Windows checkout that
# rewrote LF to CRLF would change every hash, so each tree is declared
# byte-exact.
.claude/skills/nestjs/** -text
.claude/skills/nestjs-feature/** -text
.claude/skills/nestjs-auth/** -text
.claude/skills/nestjs-data/** -text
.claude/skills/nestjs-testing/** -text
.claude/skills/nestjs-production/** -text

# The vendored `impeccable.cmd` is CRLF by design (see above), so every line
# would read as trailing whitespace to `git diff --check`. Exempt only that
# file from whitespace checks; the bytes stay hash-locked in UPSTREAM.md.
.claude/skills/impeccable/scripts/impeccable.cmd -text -whitespace
